{
  "projectName": "appstream-omniverse",
  "region": "eu-central-1",
  "fleet": {
    "instanceType": "Accelerated.g6e.xlarge",
    "instanceTypeFallback": "Accelerated.g6e.2xlarge",
    "fleetType": "ON_DEMAND",
    "minCapacity": 0,
    "maxCapacity": 1,
    "streamingProtocol": "NICE_DCV"
  },
  "image": {
    "baseAmiParameter": "/aws/service/ami-windows-latest/TPM-Windows_Server-2022-English-Full-Base",
    "marketplaceAmiId": "ami-PLACEHOLDER",
    "customImageName": "omniverse-g6e-PLACEHOLDER"
  },
  "amiBuilder": {
    "_comment": "G6e instance types tried in order for AMI creation. Must match fleet GPU family (L40S) for GRID driver compatibility.",
    "instanceTypes": [
      "g6e.xlarge",
      "g6e.2xlarge",
      "g6e.4xlarge",
      "g6e.8xlarge"
    ]
  },
  "monitoring": {
    "dashboardEnabled": true,
    "metricsRetentionDays": 7,
    "cloudWatchNamespace": "AWS/AppStream",
    "metricsToDisplay": [
      "InSessionLatency",
      "FramesPerSecond",
      "Bandwidth",
      "CpuUtilizationInstance"
    ]
  },
  "omniverse": {
    "kitAppTemplateRepo": "https://github.com/NVIDIA-Omniverse/kit-app-template"
  },
  "nucleus": {
    "enabled": true,
    "metricsEnabled": true,
    "instanceType": "c5.2xlarge",
    "storageSize": 512,
    "nucleusBuild": "nucleus-stack-2023.1.0+tag-2023.1.0.gitlab.8633670.7f07353a"
  },
  "tags": {
    "Project": "appstream-omniverse",
    "Environment": "poc"
  }
}
